# Shared git settings. Name, email and signing key live in
# ~/.config/git/local (untracked); the installer asks for them once.
[include]
    path = ~/.config/git/local
[init]
    defaultBranch = main
[pull]
    rebase = true
[push]
    autoSetupRemote = true
[rebase]
    autoStash = true
[core]
    pager = bat --paging=always --style=plain
[diff]
    colorMoved = default
[credential]
    # HTTPS usernames and passwords/tokens go to the Secret Service, which is
    # KeePassXC here (see ~/.local/share/dbus-1/services). useHttpPath keys
    # each entry by the full repo URL, so every repo can have its own
    # username and token. SSH remotes do not use this.
    helper = /usr/lib/git-core/git-credential-libsecret
    useHttpPath = true
