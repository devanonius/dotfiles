# Ghostty. Reload after editing: ctrl+shift+comma (or `pkill -USR2 ghostty`).
font-family = JetBrainsMono Nerd Font
font-size = 11
window-decoration = none
window-padding-x = 8
window-padding-y = 8
background-opacity = 0.95
shell-integration = zsh
gtk-single-instance = true
confirm-close-surface = false
copy-on-select = clipboard

# Colors come from the active theme (dot theme set), written by pywal.
# The "?" makes the file optional, so Ghostty still starts before a theme is set.
config-file = ?~/.cache/wal/colors-ghostty
