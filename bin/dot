#!/usr/bin/env bash
# dot: the single entry point for managing these dotfiles.
set -Eeuo pipefail

DOTFILES_DIR=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
export DOTFILES_DIR
# shellcheck source=lib/common.sh
source "$DOTFILES_DIR/lib/common.sh"

usage() {
  cat <<'EOF'
Usage: dot <command> [args]

  install [flags]     run install.sh, e.g. dot install -c my.json (see --help)
  update [flags]      git pull --rebase, then dot install --yes [flags]
  restow              re-link configs only (install stage "stow")
  fonts               pick Nerd Fonts again from the list and install them
  theme list          available themes (* = active)
  theme set <id>      switch every app to a theme (also: dot theme <id>)
  theme current       print the active theme id
  theme next | prev   switch to the next / previous theme
  background next | prev | list   the active theme's wallpapers (backgrounds/<id>/)
  packages list [-c FILE]   packages that apply to this machine and config
  packages check [-c FILE]  verify every package name exists (repos, AUR, flatpak)
  browser [current|list]    the browser the installer set up
  browser set <id>    switch browser (installs it, Vimium, default, colors)
  browser vimium      copy the theme's Vimium CSS to the clipboard
  edit [<app>]        open an app's config folder in the repo (no app: list them)
  doctor              check links, theme, app configs, services and drivers
  help                show this help

Also: dot-monitors [--force] writes ~/.config/hypr/local/monitors.lua.
EOF
}

cmd_update() {
  local dir=$DOTFILES_DIR
  git -C "$dir" rev-parse --git-dir >/dev/null 2>&1 || die "$dir is not a git repository"
  if ! git -C "$dir" diff --quiet || ! git -C "$dir" diff --cached --quiet; then
    git -C "$dir" status --short
    die "uncommitted changes in $dir; commit or stash them, then run dot update again"
  fi
  log "pulling $dir"
  git -C "$dir" pull --rebase
  exec bash "$dir/install.sh" --yes "$@"
}

cmd_packages() {
  local sub=list
  if (( $# )) && [[ $1 != -* ]]; then sub=$1; shift; fi
  while (( $# )); do
    case $1 in
      -c|--config) [[ -f ${2:-} ]] || die "config file not found: ${2:-}"; CONFIG_FILE=$(readlink -f "$2"); shift ;;
      *) die "unknown option: $1" ;;
    esac
    shift
  done

  # shellcheck source=lib/config.sh
  source "$DOTFILES_DIR/lib/config.sh"
  # shellcheck source=lib/detect.sh
  source "$DOTFILES_DIR/lib/detect.sh"
  config_load
  detect_all

  local module pkg
  case $sub in
    list)
      while read -r module; do
        printf '%s# module %s (packages/%s.txt, pacman)%s\n' "$C_BOLD" "$module" "$module" "$C_RESET"
        read_list "$DOTFILES_DIR/packages/$module.txt"
      done < <(enabled_modules)
      if [[ $(config_get 'if has("hardware") then .hardware else true end') == true ]]; then
        while read -r module; do
          printf '%s# hardware %s (packages/hardware/%s.txt, detected)%s\n' "$C_BOLD" "$module" "$module" "$C_RESET"
          read_list "$DOTFILES_DIR/packages/hardware/$module.txt"
        done < <(hardware_lists)
      fi
      printf '%s# fonts ("%s")%s\n' "$C_BOLD" "$(config_fonts_mode)" "$C_RESET"
      case $(config_fonts_mode) in
        list) config_fonts_list ;;
        all)  read_list "$DOTFILES_DIR/packages/fonts/nerd-fonts.txt" ;;
        ask)  if [[ -f $DOTFILES_STATE/fonts.txt ]]; then read_list "$DOTFILES_STATE/fonts.txt"; else echo "(not picked yet: dot fonts)"; fi ;;
      esac
      printf '%s# packages/aur.txt (yay)%s\n' "$C_BOLD" "$C_RESET"
      read_list "$DOTFILES_DIR/packages/aur.txt"
      printf '%s# never installed (packages/exclude.txt)%s\n' "$C_BOLD" "$C_RESET"
      read_list "$DOTFILES_DIR/packages/exclude.txt"
      for kind in pacman aur flatpak; do
        printf '%s# extra_packages.%s (config)%s\n' "$C_BOLD" "$kind" "$C_RESET"
        config_extra "$kind"
      done
      ;;
    check)
      require_cmd pacman
      local bad=0 file
      # Every module file, not only enabled ones, so a typo is caught on any machine.
      while read -r pkg; do
        pacman -Si -- "$pkg" >/dev/null 2>&1 || { warn "'$pkg' not found in the official repos"; bad=1; }
      done < <({ for file in "$DOTFILES_DIR"/packages/*.txt "$DOTFILES_DIR"/packages/hardware/*.txt "$DOTFILES_DIR"/packages/fonts/*.txt; do
                   case $(basename "$file") in aur.txt|exclude.txt) ;; *) read_list "$file" ;; esac
                 done; config_extra pacman; } | dedupe)
      if has_cmd yay; then
        while read -r pkg; do
          if ! yay -Si --aur -- "$pkg" >/dev/null 2>&1; then
            warn "'$pkg' not found in the AUR"; bad=1
          elif [[ $pkg != *-bin && $pkg != *-git ]] && yay -Si --aur -- "$pkg-bin" >/dev/null 2>&1; then
            warn "'$pkg' has a prebuilt '$pkg-bin'; list that instead (the installer swaps it in anyway)"
          fi
        done < <({ read_list "$DOTFILES_DIR/packages/aur.txt"; config_extra aur; } | dedupe)
      else
        warn "yay not installed; AUR names not checked"
      fi
      if [[ -n $(config_extra flatpak) ]]; then
        if has_cmd flatpak; then
          local remote; remote=$(config_get '.flatpak.remote // "flathub"')
          while read -r pkg; do
            flatpak remote-info "$remote" "$pkg" >/dev/null 2>&1 || { warn "flatpak '$pkg' not found on $remote"; bad=1; }
          done < <(config_extra flatpak)
        else
          warn "flatpak not installed; flatpak ids not checked"
        fi
      fi
      (( bad )) && die "some package names are wrong (see warnings above)"
      log "all package names resolve"
      ;;
    *) die "unknown: dot packages $sub. Use: list | check [-c FILE]" ;;
  esac
}

# dot edit <app>: open the app's folder in the repo (stow/<app>, or a
# top-level folder such as packages or themes) in $EDITOR. Edits there are
# live through the links; commit them from $DOTFILES_DIR.
cmd_edit() {
  local app=${1:-} dir
  if [[ -z $app ]]; then
    echo "Usage: dot edit <app>. Apps (stow/):"
    ls "$DOTFILES_DIR/stow" | sed 's/^/  /'
    echo "Also: packages, themes, browser, config, system"
    return 0
  fi
  dir="$DOTFILES_DIR/stow/$app"
  [[ -d $dir ]] || dir="$DOTFILES_DIR/$app"
  [[ -d $dir && $app != */* && $app != .* ]] || die "no app '$app' (run: dot edit)"
  cd "$dir"
  exec ${EDITOR:-nvim} .
}

cmd_browser() {
  # shellcheck source=lib/browser.sh
  source "$DOTFILES_DIR/lib/browser.sh"
  local sub=${1:-current}
  (( $# )) && shift
  case $sub in
    current) local id; id=$(browser_current); echo "${id:-none}" ;;
    list)    local id; while read -r id; do printf '%-10s %s\n' "$id" "$(browser_get "$id" name)"; done < <(browser_ids) ;;
    set)     [[ -n ${1:-} ]] || die "usage: dot browser set <id> (see: dot browser list)"
             [[ $1 == none ]] || browser_exists "$1" || die "unknown browser '$1' (see: dot browser list)"
             mkdir -p "$DOTFILES_STATE"; printf '%s\n' "$1" > "$BROWSER_STATE"
             exec bash "$DOTFILES_DIR/install.sh" --only browser ;;
    vimium)  browser_vimium_css ;;
    *)       die "unknown: dot browser $sub. Use: current | list | set <id> | vimium" ;;
  esac
}

cmd_theme() {
  # shellcheck source=lib/theme.sh
  source "$DOTFILES_DIR/lib/theme.sh"
  local sub=${1:-list}
  (( $# )) && shift
  case $sub in
    list)    theme_list ;;
    current) theme_current ;;
    set)     [[ -n ${1:-} ]] || die "usage: dot theme set <id> (see: dot theme list)"
             theme_set "$1"; log "theme: $1" ;;
    next)    local id; id=$(theme_step 1);  theme_set "$id"; log "theme: $id" ;;
    prev)    local id; id=$(theme_step -1); theme_set "$id"; log "theme: $id" ;;
    *)       # Shorthand: dot theme <id> = dot theme set <id>
             theme_exists "$sub" || die "unknown: dot theme $sub. Use: list | set <id> | <id> | current | next | prev"
             theme_set "$sub"; log "theme: $sub" ;;
  esac
}

main() {
  local cmd=${1:-help}
  (( $# )) && shift
  case $cmd in
    install)        exec bash "$DOTFILES_DIR/install.sh" "$@" ;;
    update)         cmd_update "$@" ;;
    restow)         exec bash "$DOTFILES_DIR/install.sh" --only stow "$@" ;;
    fonts)          rm -f "$DOTFILES_STATE/fonts.txt"; exec bash "$DOTFILES_DIR/install.sh" --only fonts "$@" ;;
    packages|pkg)   cmd_packages "$@" ;;
    background|bg)  source "$DOTFILES_DIR/lib/theme.sh"
                    case ${1:-next} in
                      next) background_step 1 ;;
                      prev) background_step -1 ;;
                      list) background_files "$(theme_current)" ;;
                      *) die "unknown: dot background ${1}. Use: next | prev | list" ;;
                    esac ;;
    help|-h|--help) usage ;;
    theme)          cmd_theme "$@" ;;
    doctor)         source "$DOTFILES_DIR/lib/doctor.sh"; doctor_main ;;
    browser)        cmd_browser "$@" ;;
    edit)           cmd_edit "$@" ;;
    *) usage >&2; die "unknown command: $cmd" ;;
  esac
}

main "$@"
